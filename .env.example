# --- 公開サイト（推奨・必須に近い）---
# 空室カレンダー（SaaS 公開 API）
# NEXT_PUBLIC_AVAILABILITY_API_URL=https://hotel-pg-saas.vercel.app/api/public/availability

# Stripe Checkout セッション作成（SaaS 側）。末尾スラッシュなし
# NEXT_PUBLIC_SAAS_API_BASE_URL=https://hotel-pg-saas.vercel.app

# SaaS 管理 API（料金・在庫設定の GET/PUT 中継に使用。ブラウザには出さない）
# ADMIN_API_SECRET=xxxxx

# 管理画面（クライアント）パスワード
# NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# /admin/bookings の Basic 認証（任意で利用する場合）
# ADMIN_PASSWORD=change-me

# Google Analytics 4 測定ID（未設定時はコード内の G-R5DGPBMER4 が使われます）
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R5DGPBMER4

# Maintenance mode（公開中に一時的にリニューアル表示にする）
# MAINTENANCE_MODE=1

# --- 任意: Supabase（ブログ block 形式・CMS を DB に載せる場合のみ）---
# 未設定でもビルド・公開サイトは動作します（ブログは constants / ローカル CMS）。
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 旧 Vite 名の管理パスワード互換
# VITE_ADMIN_PASSWORD=admin

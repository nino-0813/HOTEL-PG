# Server-side（API RouteでDB参照・cron同期に使用）
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# 管理画面ログイン用パスワード（本番では必ず変更）
VITE_ADMIN_PASSWORD=admin

# Google Analytics 4 測定ID（未設定時はコード内の G-R5DGPBMER4 が使われます）
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R5DGPBMER4

# Stripe（Checkout Session 作成に使用）
# STRIPE_SECRET_KEY=sk_live_xxx or sk_test_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx or pk_live_xxx

# Maintenance mode（公開中に一時的にリニューアル表示にする）
# MAINTENANCE_MODE=1

# iCal sync（楽天Oyado -> 自社 取り込み）
